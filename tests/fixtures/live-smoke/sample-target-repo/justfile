# Operator helpers for the disposable multi-region tracer.
# openci-tf remains plan-only; apply/destroy are manual operator flows.

test_account_id := "REPLACE_MAIN_ACCOUNT"
test2_account_id := "REPLACE_SECONDARY_ACCOUNT"
repo_slug := "<REPO_ORG>/<REPO_NAME>"

# Six reportable Terraform roots: four TEST hub-account roots plus two TEST2 VPC-only roots.
test_roots := "eu-west-1/01-vpc eu-west-1/02-ec2 ap-northeast-1/01-vpc ap-northeast-1/02-ec2"
test2_roots := "test2-eu-west-1/01-vpc test2-us-east-1/01-vpc"
all_roots := "eu-west-1/01-vpc eu-west-1/02-ec2 ap-northeast-1/01-vpc ap-northeast-1/02-ec2 test2-eu-west-1/01-vpc test2-us-east-1/01-vpc"

default:
    @just --list

confirm-test-account:
    #!/usr/bin/env bash
    set -euo pipefail
    read -r -p "Type TEST hub account ID to confirm ({{test_account_id}}): " acct
    if [[ "$acct" != "{{test_account_id}}" ]]; then
      echo "account confirmation failed" >&2
      exit 1
    fi

confirm-test2-account:
    #!/usr/bin/env bash
    set -euo pipefail
    read -r -p "Type TEST2 target account ID to confirm ({{test2_account_id}}): " acct
    if [[ "$acct" != "{{test2_account_id}}" ]]; then
      echo "account confirmation failed" >&2
      exit 1
    fi

confirm-destroy:
    #!/usr/bin/env bash
    set -euo pipefail
    read -r -p "Type DESTROY to confirm destructive teardown: " ans
    if [[ "$ans" != "DESTROY" ]]; then
      echo "destroy confirmation failed" >&2
      exit 1
    fi

fmt-check:
    tofu fmt -check -recursive terraform/

fmt:
    tofu fmt -recursive terraform/

validate-offline root:
    #!/usr/bin/env bash
    set -euo pipefail
    root="terraform/{{root}}"
    tf_data_dir="$(mktemp -d)"
    cleanup() {
      rm -rf "$tf_data_dir"
    }
    trap cleanup EXIT
    TF_DATA_DIR="$tf_data_dir" tofu -chdir="$root" init -backend=false -input=false
    TF_DATA_DIR="$tf_data_dir" tofu -chdir="$root" validate

validate-all:
    #!/usr/bin/env bash
    set -euo pipefail
    for root in {{all_roots}}; do
      just validate-offline "$root"
    done

test:
    python3 -m unittest discover -s tests -p 'test_*.py' -v

show-backend root:
    @grep -A8 'backend "s3"' "terraform/{{root}}/versions.tf"

init-test root: confirm-test-account
    #!/usr/bin/env bash
    set -euo pipefail
    tofu -chdir="terraform/{{root}}" init

init-test2 root: confirm-test2-account
    #!/usr/bin/env bash
    set -euo pipefail
    tofu -chdir="terraform/{{root}}" init

plan-test root: confirm-test-account
    #!/usr/bin/env bash
    set -euo pipefail
    tofu -chdir="terraform/{{root}}" plan

plan-test2 root: confirm-test2-account
    #!/usr/bin/env bash
    set -euo pipefail
    tofu -chdir="terraform/{{root}}" plan

apply-test root: confirm-test-account
    #!/usr/bin/env bash
    set -euo pipefail
    tofu -chdir="terraform/{{root}}" apply

apply-test2 root: confirm-test2-account
    #!/usr/bin/env bash
    set -euo pipefail
    tofu -chdir="terraform/{{root}}" apply

destroy-test root: confirm-test-account confirm-destroy
    #!/usr/bin/env bash
    set -euo pipefail
    tofu -chdir="terraform/{{root}}" destroy

destroy-test2 root: confirm-test2-account confirm-destroy
    #!/usr/bin/env bash
    set -euo pipefail
    tofu -chdir="terraform/{{root}}" destroy

# Backward-compatible aliases for TEST hub roots (account {{test_account_id}}).
init root: confirm-test-account
    @just init-test {{root}}

plan root: confirm-test-account
    @just plan-test {{root}}

apply root: confirm-test-account
    @just apply-test {{root}}

destroy root: confirm-test-account confirm-destroy
    @just destroy-test {{root}}

apply-test-all: confirm-test-account
    #!/usr/bin/env bash
    set -euo pipefail
    for root in {{test_roots}}; do
      just apply-test "$root"
    done

apply-test2-all: confirm-test2-account
    #!/usr/bin/env bash
    set -euo pipefail
    for root in {{test2_roots}}; do
      just apply-test2 "$root"
    done

destroy-test-all: confirm-test-account confirm-destroy
    #!/usr/bin/env bash
    set -euo pipefail
    for root in ap-northeast-1/02-ec2 ap-northeast-1/01-vpc eu-west-1/02-ec2 eu-west-1/01-vpc; do
      just destroy-test "$root"
    done

destroy-test2-all: confirm-test2-account confirm-destroy
    #!/usr/bin/env bash
    set -euo pipefail
    for root in test2-us-east-1/01-vpc test2-eu-west-1/01-vpc; do
      just destroy-test2 "$root"
    done

ci-check: fmt-check validate-all test
